{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:traffic:prototype-run-report-v1",
  "title": "Prototype run report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "run_id", "created_at_utc", "input_session_id", "inputs", "versions", "forecast", "analysis_outcome", "alternatives", "comparisons", "operator_decisions", "applied_outcome", "failures", "resources"],
  "properties": {
    "schema_version": {"const": "prototype-run-report-v1"},
    "report_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "input_session_id": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "versions": {"$ref": "#/$defs/versions"},
    "forecast": {"$ref": "#/$defs/forecast"},
    "analysis_outcome": {"enum": ["recommend", "no_action", "cannot_evaluate"]},
    "alternatives": {"type": "array", "items": {"$ref": "#/$defs/alternative"}},
    "comparisons": {"type": "array", "items": {"$ref": "#/$defs/comparison"}},
    "operator_decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "applied_outcome": {"anyOf": [{"$ref": "#/$defs/applied_outcome"}, {"type": "null"}]},
    "failures": {"type": "array", "items": {"$ref": "#/$defs/failure"}},
    "resources": {"$ref": "#/$defs/resources"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["camera_id", "clip_sha256", "geometry_sha256", "detector_version", "tracker_version", "observation_schema_version", "source_session_id", "last_finalized_window_end_source_s", "processing_mode", "validation_level"],
      "properties": {
        "camera_id": {"type": "string"},
        "clip_sha256": {"$ref": "#/$defs/sha256"},
        "geometry_sha256": {"$ref": "#/$defs/sha256"},
        "detector_version": {"type": "string"},
        "tracker_version": {"type": "string"},
        "observation_schema_version": {"type": "string"},
        "source_session_id": {"type": "string"},
        "last_finalized_window_end_source_s": {"type": "number", "minimum": 0},
        "processing_mode": {"enum": ["online_inference", "cached_observations", "synthetic_replay"]},
        "validation_level": {"enum": ["provisional_unreviewed", "agent_reviewed", "independently_verified"]}
      }
    },
    "versions": {
      "type": "object", "additionalProperties": false,
      "required": ["config_hash", "model_version", "metrics_version", "scoring_version"],
      "properties": {
        "config_hash": {"$ref": "#/$defs/sha256"},
        "model_version": {"type": "string"},
        "metrics_version": {"type": "string"},
        "scoring_version": {"type": "string"}
      }
    },
    "forecast": {
      "type": "object", "additionalProperties": false,
      "required": ["origin_source_s", "method", "input_quality", "horizons", "uncertainty"],
      "properties": {
        "origin_source_s": {"type": "number", "minimum": 0},
        "method": {"enum": ["persistence", "ewma", "unavailable"]},
        "input_quality": {"type": "string"},
        "horizons": {"type": "array", "items": {"$ref": "#/$defs/horizon"}},
        "uncertainty": {"$ref": "#/$defs/metric"}
      }
    },
    "horizon": {
      "type": "object", "additionalProperties": false,
      "required": ["horizon_s", "status", "recorded_score_status"],
      "properties": {
        "horizon_s": {"enum": [30, 60, 120, 300]},
        "status": {"enum": ["available", "insufficient_history", "missing_input", "stale_input"]},
        "recorded_score_status": {"enum": ["available", "unsupported_reference", "not_evaluated"]}
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "availability"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "availability": {"type": "string", "minLength": 1}
      }
    },
    "alternative": {
      "type": "object", "additionalProperties": false,
      "required": ["recommendation_id", "status", "safety_status", "changes"],
      "properties": {
        "recommendation_id": {"type": "string"},
        "status": {"type": "string"},
        "safety_status": {"type": "string"},
        "changes": {"type": "array", "items": {"$ref": "#/$defs/timing_change"}}
      }
    },
    "timing_change": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "phase_id", "green_s"],
      "properties": {
        "node_id": {"type": "string"},
        "phase_id": {"type": "string"},
        "green_s": {"type": "number", "minimum": 0},
        "offset_s": {"type": "number", "minimum": 0}
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["recommendation_id", "window_start_simulation_s", "window_end_simulation_s", "demand_assumptions_hash", "baseline", "candidate"],
      "properties": {
        "recommendation_id": {"type": "string"},
        "window_start_simulation_s": {"type": "number", "minimum": 0},
        "window_end_simulation_s": {"type": "number", "minimum": 0},
        "demand_assumptions_hash": {"type": "string"},
        "baseline": {"$ref": "#/$defs/comparison_metrics"},
        "candidate": {"$ref": "#/$defs/comparison_metrics"}
      }
    },
    "comparison_metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["queue_delay_veh_s", "boundary_exits_veh", "boundary_backlog_veh", "boundary_wait_veh_s", "worst_service_debt_s"],
      "properties": {
        "queue_delay_veh_s": {"type": "number", "minimum": 0},
        "boundary_exits_veh": {"type": "number", "minimum": 0},
        "boundary_backlog_veh": {"type": "number", "minimum": 0},
        "boundary_wait_veh_s": {"type": "number", "minimum": 0},
        "worst_service_debt_s": {"type": "number", "minimum": 0}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["command_id", "actor", "action", "recommendation_id", "reason", "decided_at_utc"],
      "properties": {
        "command_id": {"type": "string"},
        "actor": {"type": "string"},
        "action": {"enum": ["approve", "modify", "reject"]},
        "recommendation_id": {"type": "string"},
        "reason": {"type": "string"},
        "decided_at_utc": {"type": "string", "format": "date-time"}
      }
    },
    "applied_outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["command_id", "status", "resolved_at_utc"],
      "properties": {
        "command_id": {"type": "string"},
        "status": {"enum": ["applied", "rejected", "timed_out"]},
        "resolved_at_utc": {"type": "string", "format": "date-time"},
        "applied_at_simulation_s": {"type": "number", "minimum": 0},
        "reason": {"type": "string"}
      }
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "occurred_at_utc", "message"],
      "properties": {
        "code": {"type": "string"},
        "occurred_at_utc": {"type": "string", "format": "date-time"},
        "message": {"type": "string"}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["fresh_inference_fps", "recommendation_latency_s", "peak_cpu_percent", "peak_ram_bytes"],
      "properties": {
        "fresh_inference_fps": {"$ref": "#/$defs/metric"},
        "recommendation_latency_s": {"$ref": "#/$defs/metric"},
        "peak_cpu_percent": {"$ref": "#/$defs/metric"},
        "peak_ram_bytes": {"$ref": "#/$defs/metric"}
      }
    }
  }
}
