{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "updated_at": "2026-09-18",
  "description": "Exhaustive endpoint ownership, RPC dependencies, persistence classes, and role requirements for the Traffic Digital Twin Go API Gateway.",
  "endpoints": [
    {
      "method": "GET",
      "path": "/health/live",
      "go_owner": "Server.healthLive",
      "rpc_dependency": "none",
      "persistence_class": "none",
      "is_mutating": false,
      "required_role": "public",
      "idempotency_supported": false,
      "description": "Process liveness probe returning 200 live: true"
    },
    {
      "method": "GET",
      "path": "/health/ready",
      "go_owner": "Server.healthReady",
      "rpc_dependency": "none",
      "persistence_class": "read_only_query",
      "is_mutating": false,
      "required_role": "public",
      "idempotency_supported": false,
      "description": "Process readiness probe verifying PostgreSQL connection and component states"
    },
    {
      "method": "GET",
      "path": "/api/v1/health",
      "go_owner": "Server.health",
      "rpc_dependency": "none",
      "persistence_class": "read_only_query",
      "is_mutating": false,
      "required_role": "public",
      "idempotency_supported": false,
      "description": "Aggregated component health status for UI display"
    },
    {
      "method": "GET",
      "path": "/api/v1/network",
      "go_owner": "Server.network",
      "rpc_dependency": "none",
      "persistence_class": "none",
      "is_mutating": false,
      "required_role": "public",
      "idempotency_supported": false,
      "description": "Static network topology and signal phase configuration"
    },
    {
      "method": "GET",
      "path": "/api/v1/state",
      "go_owner": "Server.state",
      "rpc_dependency": "none",
      "persistence_class": "none",
      "is_mutating": false,
      "required_role": "public",
      "idempotency_supported": false,
      "description": "Latest in-memory validated traffic state from simulation stream"
    },
    {
      "method": "GET",
      "path": "/api/v1/junctions/{id}",
      "go_owner": "Server.junction",
      "rpc_dependency": "none",
      "persistence_class": "none",
      "is_mutating": false,
      "required_role": "public",
      "idempotency_supported": false,
      "description": "Configured junction node and associated signal phases"
    },
    {
      "method": "GET",
      "path": "/api/v1/runs",
      "go_owner": "Server.listRuns",
      "rpc_dependency": "none",
      "persistence_class": "read_only_query",
      "is_mutating": false,
      "required_role": "viewer",
      "idempotency_supported": false,
      "description": "Historical scenario runs from PostgreSQL"
    },
    {
      "method": "POST",
      "path": "/api/v1/runs",
      "go_owner": "Server.createRun",
      "rpc_dependency": "none",
      "persistence_class": "transactional_write",
      "is_mutating": true,
      "required_role": "operator",
      "idempotency_supported": true,
      "description": "Prepare a new scenario run record in PostgreSQL"
    },
    {
      "method": "GET",
      "path": "/api/v1/audit",
      "go_owner": "Server.audit",
      "rpc_dependency": "none",
      "persistence_class": "read_only_query",
      "is_mutating": false,
      "required_role": "viewer",
      "idempotency_supported": false,
      "description": "Cursor-paginated audit trail events from PostgreSQL"
    },
    {
      "method": "GET",
      "path": "/api/v1/recommendations/active",
      "go_owner": "Server.activeRecommendation",
      "rpc_dependency": "none",
      "persistence_class": "none",
      "is_mutating": false,
      "required_role": "viewer",
      "idempotency_supported": false,
      "description": "Currently active actionable timing recommendation"
    },
    {
      "method": "GET",
      "path": "/api/v1/analysis",
      "go_owner": "Server.getAnalysis",
      "rpc_dependency": "none",
      "persistence_class": "none",
      "is_mutating": false,
      "required_role": "viewer",
      "idempotency_supported": false,
      "description": "Current intelligence forecasts and recommendation bundle"
    },
    {
      "method": "POST",
      "path": "/api/v1/recommendations/{id}/simulate",
      "go_owner": "Server.decision",
      "rpc_dependency": "Intelligence.Compare",
      "persistence_class": "transactional_write",
      "is_mutating": true,
      "required_role": "operator",
      "idempotency_supported": true,
      "description": "Simulate outcome of a timing recommendation without actuation"
    },
    {
      "method": "POST",
      "path": "/api/v1/recommendations/{id}/approve",
      "go_owner": "Server.decision",
      "rpc_dependency": "Simulation.ApplyPlan",
      "persistence_class": "transactional_write",
      "is_mutating": true,
      "required_role": "operator",
      "idempotency_supported": true,
      "description": "Approve and apply timing changes to the virtual simulation"
    },
    {
      "method": "POST",
      "path": "/api/v1/recommendations/{id}/modify",
      "go_owner": "Server.decision",
      "rpc_dependency": "Simulation.ApplyPlan / Intelligence.Compare",
      "persistence_class": "transactional_write",
      "is_mutating": true,
      "required_role": "operator",
      "idempotency_supported": true,
      "description": "Modify parameters of a recommendation and apply with audit reason"
    },
    {
      "method": "POST",
      "path": "/api/v1/recommendations/{id}/reject",
      "go_owner": "Server.decision",
      "rpc_dependency": "none",
      "persistence_class": "transactional_write",
      "is_mutating": true,
      "required_role": "operator",
      "idempotency_supported": true,
      "description": "Reject a recommendation with an operator-audited reason"
    },
    {
      "method": "POST",
      "path": "/api/v1/scenarios/{type}/start",
      "go_owner": "Server.startScenario",
      "rpc_dependency": "Simulation.Reset",
      "persistence_class": "transactional_write",
      "is_mutating": true,
      "required_role": "operator",
      "idempotency_supported": true,
      "description": "Start a seeded aggregate-flow scenario in observe, recommend, or manual mode"
    },
    {
      "method": "POST",
      "path": "/api/v1/scenarios/reset",
      "go_owner": "Server.resetScenario",
      "rpc_dependency": "Simulation.Reset",
      "persistence_class": "transactional_write",
      "is_mutating": true,
      "required_role": "operator",
      "idempotency_supported": true,
      "description": "Reset current scenario to identical seed and initial conditions"
    },
    {
      "method": "GET",
      "path": "/api/v1/decisions/unresolved",
      "go_owner": "Server.getUnresolvedDecisions",
      "rpc_dependency": "none",
      "persistence_class": "read_only_query",
      "is_mutating": false,
      "required_role": "supervisor",
      "idempotency_supported": false,
      "description": "List unsettled decision intents awaiting supervisor reconciliation"
    },
    {
      "method": "POST",
      "path": "/api/v1/decisions/resolve",
      "go_owner": "Server.resolveDecision",
      "rpc_dependency": "none",
      "persistence_class": "transactional_write",
      "is_mutating": true,
      "required_role": "supervisor",
      "idempotency_supported": true,
      "description": "Reconcile an ambiguous decision intent by supervisor"
    },
    {
      "method": "GET",
      "path": "/api/v1/mode",
      "go_owner": "Server.getMode",
      "rpc_dependency": "none",
      "persistence_class": "read_only_query",
      "is_mutating": false,
      "required_role": "viewer",
      "idempotency_supported": false,
      "description": "Authoritative operating mode and active control locks"
    },
    {
      "method": "POST",
      "path": "/api/v1/mode/{mode}",
      "go_owner": "Server.setMode",
      "rpc_dependency": "none",
      "persistence_class": "transactional_write",
      "is_mutating": true,
      "required_role": "operator",
      "idempotency_supported": true,
      "description": "Change operating mode to observe, recommend, or manual"
    },
    {
      "method": "GET",
      "path": "/api/v1/locks",
      "go_owner": "Server.listLocks",
      "rpc_dependency": "none",
      "persistence_class": "read_only_query",
      "is_mutating": false,
      "required_role": "viewer",
      "idempotency_supported": false,
      "description": "List persistent timing locks"
    },
    {
      "method": "POST",
      "path": "/api/v1/locks/{id}",
      "go_owner": "Server.setLock",
      "rpc_dependency": "none",
      "persistence_class": "transactional_write",
      "is_mutating": true,
      "required_role": "operator",
      "idempotency_supported": true,
      "description": "Apply a persistent timing lock to a configured phase or movement"
    },
    {
      "method": "DELETE",
      "path": "/api/v1/locks/{id}",
      "go_owner": "Server.deleteLock",
      "rpc_dependency": "none",
      "persistence_class": "transactional_write",
      "is_mutating": true,
      "required_role": "operator",
      "idempotency_supported": true,
      "description": "Release a persistent timing lock"
    },
    {
      "method": "POST",
      "path": "/api/v1/replay/{scenario}",
      "go_owner": "Server.startReplay",
      "rpc_dependency": "none",
      "persistence_class": "transactional_write",
      "is_mutating": true,
      "required_role": "operator",
      "idempotency_supported": true,
      "description": "Start golden replay from verified prerecorded synthetic traffic"
    },
    {
      "method": "GET",
      "path": "/api/v1/vision/{id}",
      "go_owner": "Server.getVisionState",
      "rpc_dependency": "none",
      "persistence_class": "none",
      "is_mutating": false,
      "required_role": "viewer",
      "idempotency_supported": false,
      "description": "Sample vision aggregates and camera status for junction C3"
    },
    {
      "method": "GET",
      "path": "/api/v1/commands/{id}",
      "go_owner": "Server.getCommand",
      "rpc_dependency": "none",
      "persistence_class": "read_only_query",
      "is_mutating": false,
      "required_role": "viewer",
      "idempotency_supported": false,
      "description": "Permissioned command outcome reconciliation status"
    },
    {
      "method": "GET",
      "path": "/api/v1/session",
      "go_owner": "Server.getSession",
      "rpc_dependency": "none",
      "persistence_class": "none",
      "is_mutating": false,
      "required_role": "viewer",
      "idempotency_supported": false,
      "description": "Read active operator/supervisor session status"
    },
    {
      "method": "POST",
      "path": "/api/v1/session/login",
      "go_owner": "Server.loginSession",
      "rpc_dependency": "none",
      "persistence_class": "none",
      "is_mutating": true,
      "required_role": "public",
      "idempotency_supported": false,
      "description": "Authenticate operator or supervisor session"
    },
    {
      "method": "POST",
      "path": "/api/v1/session/logout",
      "go_owner": "Server.logoutSession",
      "rpc_dependency": "none",
      "persistence_class": "none",
      "is_mutating": true,
      "required_role": "public",
      "idempotency_supported": false,
      "description": "Sign out of active session"
    },
    {
      "method": "GET",
      "path": "/ws/v1/live",
      "go_owner": "Server.live",
      "rpc_dependency": "Simulation.StreamState",
      "persistence_class": "none",
      "is_mutating": false,
      "required_role": "viewer",
      "idempotency_supported": false,
      "description": "Live WebSocket stream for traffic frames, audit events, and component health"
    }
  ]
}
