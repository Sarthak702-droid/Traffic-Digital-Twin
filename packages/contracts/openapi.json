          },
          "safety_status": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "explanation_facts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "run_id",
          "timestamp",
          "priority",
          "reason",
          "changes",
          "safety_status",
          "status",
          "explanation_facts"
