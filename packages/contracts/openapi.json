  "components": {
    "schemas": {
      "Node": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind",
          "x",
          "y"
        ]
      },
      "Link": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "from_node": {
            "type": "string"
          },
          "to_node": {
            "type": "string"
          },
          "length_m": {
            "type": "number"
          },
          "lanes": {
            "type": "integer",
            "minimum": 0
          },
          "storage_capacity_veh": {
            "type": "integer",
            "minimum": 0
          },
          "free_flow_speed_kph": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "from_node",
          "to_node",
          "length_m",
          "lanes",
          "storage_capacity_veh",
          "free_flow_speed_kph"
        ]
      },
      "Movement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "incoming_link_id": {
            "type": "string"
          },
          "outgoing_link_id": {
            "type": "string"
          },
          "turning_ratio": {
            "type": "number"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "node_id",
          "incoming_link_id",
          "outgoing_link_id",
          "turning_ratio"
        ]
      },
      "SignalPhase": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "movement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min_green_s": {
            "type": "number",
            "minimum": 0
          },
          "max_green_s": {
            "type": "number",
            "minimum": 0
          },
          "amber_s": {
            "type": "number",
            "minimum": 0
          },
          "all_red_s": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "node_id",
          "movement_ids",
          "min_green_s",
          "max_green_s",
          "amber_s",
          "all_red_s"
        ]
      },
      "MovementState": {
        "type": "object",
        "properties": {
          "movement_id": {
            "type": "string"
          },
          "queue_veh": {
            "type": "number",
            "minimum": 0
          },
          "arrival_rate_vpm": {
            "type": "number",
            "minimum": 0
          },
          "departure_rate_vpm": {
            "type": "number",
            "minimum": 0
          },
          "avg_speed_kph": {
            "type": "number",
            "minimum": 0
          },
          "occupancy_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "downstream_capacity_veh": {
            "type": "number",
            "minimum": 0
          },
          "current_phase_id": {
            "type": "string"
          },
          "waiting_age_s": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "movement_id",
          "queue_veh",
          "arrival_rate_vpm",
          "departure_rate_vpm",
          "avg_speed_kph",
          "occupancy_ratio",
          "downstream_capacity_veh",
          "current_phase_id",
          "waiting_age_s"
        ]
      },
      "TrafficState": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "run_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "simulation_time_s": {
            "type": "number",
            "minimum": 0
          },
          "source": {
            "type": "string"
          },
          "movements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MovementState"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "schema_version",
          "run_id",
          "timestamp",
          "simulation_time_s",
          "source",
          "movements"
        ]
      },
      "Forecast": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "movement_id": {
            "type": "string"
          },
          "horizon_s": {
            "type": "integer",
            "minimum": 0
          },
          "queue_veh": {
            "type": "number",
            "minimum": 0
          },
          "occupancy_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "arrivals_veh": {
            "type": "number",
            "minimum": 0
          },
          "risk": {
            "type": "string"
          },
          "spillback_eta_s": {
            "type": "number"
          },
          "model_version": {
            "type": "string"
          },
          "explanation_facts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "run_id",
          "movement_id",
          "horizon_s",
          "queue_veh",
          "occupancy_ratio",
          "arrivals_veh",
          "risk",
          "model_version",
          "explanation_facts"
        ]
      },
      "TimingChange": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string"
          },
          "phase_id": {
            "type": "string"
          },
          "green_s": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "node_id",
          "phase_id",
          "green_s"
        ]
      },
      "Recommendation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "changes": {
            "type": "array",
            "items": {
