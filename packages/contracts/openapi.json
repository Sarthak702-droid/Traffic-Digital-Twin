            }
          },
          "after": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimingChange"
            }
          },
          "reason": {
            "type": "string"
          },
          "safety_result": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "run_id",
          "timestamp",
          "actor",
          "recommendation_id",
          "event_type",
          "before",
          "after",
          "reason",
          "safety_result"
        ]
      },
      "Alert": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "target_id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "run_id",
          "severity",
          "target_id",
          "message"
        ]
      },
      "SignalState": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string"
          },
          "phase_id": {
            "type": "string"
          },
          "indication": {
            "type": "string"
          },
          "remaining_s": {
            "type": "number",
            "minimum": 0
          }
