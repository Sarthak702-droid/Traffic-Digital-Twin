        "current_phase_id": {
          "type": "string"
        },
        "waiting_age_s": {
          "type": "number",
          "minimum": 0
        },
        "vehicle_count": {
          "type": "integer",
          "minimum": 0
        },
        "arrivals_total": {
          "type": "integer",
          "minimum": 0
