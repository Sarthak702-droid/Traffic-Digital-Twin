        "max_green_s": {
          "type": "number",
          "minimum": 0
        },
        "amber_s": {
          "type": "number",
          "minimum": 0
        },
        "all_red_s": {
          "type": "number",
          "minimum": 0
        },
        "pedestrian_clearance_s": {
          "type": "number",
          "minimum": 0
