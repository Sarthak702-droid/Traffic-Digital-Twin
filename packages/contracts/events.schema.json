        "stock_veh": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "link_id",
        "stock_veh"
      ]
    },
    "BoundaryDemandState": {
      "type": "object",
      "properties": {
        "link_id": {
          "type": "string"
