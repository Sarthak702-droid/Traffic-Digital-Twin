      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "sequence": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "const": "recommendation.updated"
        },
        "payload": {
          "$ref": "#/$defs/Recommendation"
        }
      }
    },
    {
      "type": "object",
