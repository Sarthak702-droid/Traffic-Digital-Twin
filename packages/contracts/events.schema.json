          "items": {
            "$ref": "#/$defs/CellStock"
          }
        },
        "boundary_demand": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BoundaryDemandState"
          }
        },
        "input_session_id": {
          "type": "string"
        },
        "latest_finalized_window_end_source_s": {
          "type": "number"
        },
        "observation_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FinalizedObservation"
          }
        },
        "input_quality": {
          "enum": [
            "",
