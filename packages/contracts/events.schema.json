          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "x",
        "y"
      ]
    },
    "Link": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "from_node": {
          "type": "string"
        },
        "to_node": {
          "type": "string"
        },
        "length_m": {
          "type": "number"
        },
        "lanes": {
          "type": "integer",
          "minimum": 0
        },
        "storage_capacity_veh": {
          "type": "integer",
          "minimum": 0
        },
        "free_flow_speed_kph": {
          "type": "number",
          "minimum": 0
