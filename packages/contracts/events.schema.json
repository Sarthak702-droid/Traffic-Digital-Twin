      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "sequence": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "const": "incident.updated"
        },
        "payload": {
          "$ref": "#/$defs/Incident"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "sequence",
        "timestamp",
        "type",
        "payload"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "sequence": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "const": "emergency.updated"
        },
        "payload": {
          "$ref": "#/$defs/EmergencyEvent"
