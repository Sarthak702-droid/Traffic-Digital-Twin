      "additionalProperties": false,
      "required": [
        "observation_id",
        "camera_id",
        "boundary_link_id",
        "window_start_s",
        "window_end_s",
        "available_at_source_s",
        "processed_at_utc",
        "crossings_veh",
        "observation_status",
        "queue_status"
      ]
    },
    "TrafficState": {
      "type": "object",
      "properties": {
        "schema_version": {
          "enum": [
            "1.0",
