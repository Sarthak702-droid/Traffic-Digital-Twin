        "queued_veh_estimate": {
          "type": "number"
        },
        "density_veh_per_km_lane": {
          "type": "number"
        },
        "storage_utilization_ratio": {
          "type": "number"
        },
        "receiving_storage_veh": {
          "type": "number",
          "minimum": 0
        },
        "inflow_vpm": {
          "type": "number",
          "minimum": 0
        },
        "outflow_vpm": {
          "type": "number",
          "minimum": 0
        },
        "flow_window_s": {
          "type": "number",
          "minimum": 0
        },
        "mean_speed_kph": {
          "type": "number"
