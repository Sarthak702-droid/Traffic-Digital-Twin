        "vehicles_in_network": {
          "type": "integer",
          "minimum": 0
        },
        "inserted_total": {
          "type": "integer",
          "minimum": 0
        },
        "arrived_total": {
          "type": "integer",
          "minimum": 0
        },
        "teleported_total": {
          "type": "integer",
          "minimum": 0
        },
        "scenario_type": {
          "type": "string"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "incident": {
          "anyOf": [
            {
              "$ref": "#/$defs/Incident"
            },
            {
              "type": "null"
            }
          ]
        },
        "emergency": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmergencyEvent"
            },
