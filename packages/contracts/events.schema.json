        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LinkAggregate"
          }
        },
        "engine_kind": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "metrics_version": {
          "type": "string"
        },
        "config_hash": {
          "type": "string"
        },
        "snapshot_sequence": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "boundary_backlog_veh": {
          "type": "number"
        },
        "cumulative_demand_veh": {
          "type": "number"
        },
        "cumulative_admitted_veh": {
          "type": "number"
        },
        "cumulative_boundary_exits_veh": {
          "type": "number"
        },
        "control_target": {
          "type": "string"
        },
        "scheduler": {
          "anyOf": [
