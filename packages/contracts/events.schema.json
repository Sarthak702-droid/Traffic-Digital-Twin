        "priority": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SchedulerPriority"
          }
        },
        "recovering": {
          "type": "boolean"
        },
        "activate_not_before_tick": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "offsets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SchedulerOffset"
          }
        },
        "releases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SchedulerRelease"
          }
        },
        "waiting_node_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requested_at_tick": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "applied_at_tick": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "rejected_reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "tick",
        "pending_plan",
        "service_history",
        "priority",
        "recovering"
      ]
    },
    "CellStock": {
      "type": "object",
      "properties": {
        "link_id": {
          "type": "string"
