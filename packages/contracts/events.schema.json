        "geometry_sha256": {
          "type": "string"
        },
        "detector_version": {
          "type": "string"
        },
        "tracker_version": {
          "type": "string"
        },
        "observation_schema_version": {
          "type": "string"
        },
        "source_session_id": {
          "type": "string"
        },
        "config_hash": {
          "type": "string"
        },
        "processing_mode": {
          "enum": [
            "online_inference",
            "cached_observations",
            "synthetic_replay"
