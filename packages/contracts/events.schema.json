          "type": "array",
          "items": {
            "$ref": "#/$defs/Recommendation"
          }
        },
        "input_session_id": {
          "type": "string"
        },
        "snapshot_sequence": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "config_hash": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "metrics_version": {
          "type": "string"
        },
        "forecast_origin_source_s": {
          "type": "number"
        },
        "input_quality": {
          "enum": [
            "",
            "fresh",
            "cached_valid",
            "synthetic",
            "missing",
            "stale",
            "degraded",
            "out_of_order",
            "duplicate",
            "replay"
          ]
        },
        "outcome": {
          "enum": [
            "",
            "recommend",
            "no_action",
            "cannot_evaluate"
          ]
        },
        "outcome_reason": {
          "type": "string"
        },
        "horizon_availability": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HorizonAvailability"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "run_id",
        "simulation_time_s",
        "forecasts",
        "alternatives"
      ]
    },
    "CompareCommand": {
      "type": "object",
      "properties": {
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrafficState"
            },
            {
              "type": "null"
            }
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimingChange"
          }
        },
        "recommendation_id": {
          "type": "string"
        },
        "horizon_s": {
          "type": "integer",
          "minimum": 0
        },
        "demand_assumptions_hash": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "changes",
        "recommendation_id"
      ]
    },
    "SourceTimeMapping": {
      "type": "object",
      "properties": {
        "source_origin_s": {
          "type": "number",
          "minimum": 0
        },
        "simulation_origin_s": {
          "type": "number",
          "minimum": 0
        },
        "source_seconds_per_simulation_second": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "required": [
        "source_origin_s",
        "simulation_origin_s",
        "source_seconds_per_simulation_second"
      ]
    }
  }
}
