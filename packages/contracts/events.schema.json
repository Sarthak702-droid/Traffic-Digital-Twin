      "additionalProperties": false,
      "required": [
        "link_id",
        "stock_veh",
        "queued_veh_estimate",
        "density_veh_per_km_lane",
        "storage_utilization_ratio",
        "receiving_storage_veh",
        "inflow_vpm",
        "outflow_vpm",
        "flow_window_s",
        "speed_method",
        "speed_status",
        "queue_length_m_estimate",
        "receiving_blocked"
      ]
