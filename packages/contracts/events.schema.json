    "FinalizedObservation": {
      "type": "object",
      "properties": {
        "observation_id": {
          "type": "string"
        },
        "camera_id": {
          "type": "string"
        },
        "boundary_link_id": {
          "type": "string"
        },
        "window_start_s": {
          "type": "number",
          "minimum": 0
        },
        "window_end_s": {
          "type": "number",
          "minimum": 0
        },
        "available_at_source_s": {
          "type": "number",
          "minimum": 0
        },
        "processed_at_utc": {
          "type": "string"
        },
        "crossings_veh": {
          "type": "integer",
          "minimum": 0
        },
        "observation_status": {
          "enum": [
            "valid",
            "degraded",
            "invalid"
          ]
        },
        "source_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "queue_visible_veh_estimate": {
          "type": "integer",
          "minimum": 0
        },
        "queue_status": {
          "type": "string"
        },
        "release_start_simulation_s": {
          "type": "number"
        }
