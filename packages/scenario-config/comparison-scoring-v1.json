{
  "version": "comparison-scoring-v1.1",
  "window_s": 120,
  "max_candidates": 5,
  "max_alternatives": 3,
  "max_concurrent_analyses": 1,
  "analysis_timeout_s": 1.5,
  "minimum_benefit_points": 10.0,
  "regression_limits": {
    "primary_queue_delay_reduction_min": 0.05,
    "boundary_exits_regression_max": 0.02,
    "boundary_backlog_regression_max": 0.02,
    "boundary_wait_regression_max": 0.02,
    "spillback_exposure_regression_max": 0.02,
    "worst_service_debt_regression_max": 0.10
  },
  "metric_units": {
    "queue_delay": "veh_s",
    "boundary_wait": "veh_s",
    "congested": "link_s",
    "throughput": "veh",
    "worst_service_debt": "s",
    "timing_change": "s"
  },
  "weights": {
    "normal": {
      "queue_delay": 1.0,
      "boundary_wait": 1.5,
      "congested": 10.0,
      "throughput": -5.0,
      "worst_service_debt": 0.25,
      "timing_change": 0.1
    },
    "emergency_priority": {
      "queue_delay": 0.5,
      "boundary_wait": 1.0,
      "congested": 10.0,
      "throughput": -5.0,
      "worst_service_debt": 2.0,
      "timing_change": 0.1
    },
    "emergency_recovery": {
      "queue_delay": 1.0,
      "boundary_wait": 1.5,
      "congested": 10.0,
      "throughput": -5.0,
      "worst_service_debt": 1.0,
      "timing_change": 0.1
    }
  }
}
