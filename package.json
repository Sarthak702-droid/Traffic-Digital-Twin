{
  "name": "traffic-digital-twin",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "start": "python3 scripts/start-all.py",
    "dev": "python3 scripts/start-all.py",
    "dev:all": "python3 scripts/start-all.py",
    "dev:web": "npm run dev -w apps/web",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "build:bin": "mkdir -p bin && go build -o bin/writer ./apps/api/cmd/writer && go build -o bin/api ./apps/api/cmd/api",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "test:ui": "npm run test -w apps/web",
    "dashboard": "node server.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.6.2"
  }
}
