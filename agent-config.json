    "itd_verification_status": "VERIFIED_LOCAL",
    "reuse_existing_itd_checkpoint": true,
    "allow_itd_redownload": false
  },
  "agent": {
    "mode": "agent_led",
    "geometry_review_policy": "agent_accepted_demo_with_evidence",
    "annotation_review_policy": "agent_reviewed_not_independent",
    "independent_accuracy_claim_allowed": false,
    "max_concurrent_build_workstreams": 3,
    "serialize_gpu_benchmarks": true
  },
  "permissions": {
    "paid_resource_budget": 0,
    "budget_currency": "USD",
    "allow_external_media_upload": false,
    "allow_main_push": false,
    "allow_raw_asset_deletion": false,
    "allow_driver_changes": false,
    "intended_use_rights_status": "DEMO_EVALUATION_ONLY"
  },
  "runtime": {
    "processing_modes_required": [
      "cached_observations",
      "online_inference"
    ],
    "media_source": "recorded_video",
    "max_camera_sessions": 12,
    "target_inference_fps": 8,
    "batch_max": 4,
    "batch_wait_ms": 20,
    "queue_frames_per_camera": 4,
    "recorded_overload_policy": "backpressure",
    "state_interval_s": 1,
    "analysis_interval_s": 5,
    "control_target": "virtual_only"
