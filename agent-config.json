  "forecast": {
    "baseline": "persistence",
    "default": "ewma",
    "alpha_starting_assumption": 0.3,
    "warmup_valid_bins": 6,
    "challenger": "damped_holt",
    "challenger_promotion_required": true,
    "horizons_s": [
      30,
      60,
      120,
      300
    ],
    "candidate_horizon_s": 120,
    "allow_hidden_future_data": false,
    "uncertainty_type": "named_scenarios_not_confidence_intervals"
