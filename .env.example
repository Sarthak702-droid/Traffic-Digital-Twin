# Local demonstration only. Bind every service to loopback.
# The Go API owns persistence; Vite proxies the browser's API calls to it.
DATABASE_URL=postgres://traffic:traffic_demo@127.0.0.1:5433/traffic?sslmode=disable
API_ADDR=127.0.0.1:8081
API_ORIGIN=http://127.0.0.1:8081
NETWORK_CONFIG=packages/scenario-config/c1-c6.json
UI_ORIGIN=http://127.0.0.1:3100
SIMULATION_ADDR=127.0.0.1:50051
INTELLIGENCE_ADDR=127.0.0.1:50052
REPLAY_DIR=packages/replay

# Generate COMPUTE_TOKEN with scripts/bootstrap-local.py; never commit it.
